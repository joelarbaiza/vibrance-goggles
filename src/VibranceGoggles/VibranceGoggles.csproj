<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and Windows 11: no runtime to install. -->
    <TargetFramework>net48</TargetFramework>
    <!-- The Intel and AMD driver libraries are 64-bit only. -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VibranceGoggles</AssemblyName>
    <RootNamespace>VibranceGoggles</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>1.2.1</Version>
    <!-- Product version must be exactly X.Y.Z (no "+commit" suffix): code signing pins it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Vibrance Goggles</Product>
    <Description>Digital vibrance (saturation) booster for Intel and AMD integrated graphics.</Description>
    <Company>Joel Arbaiza</Company>
    <Authors>Joel Arbaiza</Authors>
    <Copyright>Copyright (c) 2026 Joel Arbaiza</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window / tray icons that follow the Windows light or dark mode (loaded by UI/AppIcons.cs). -->
    <EmbeddedResource Include="..\..\assets\icon-dark.ico" LogicalName="VibranceGoggles.Icons.Dark.ico" />
    <EmbeddedResource Include="..\..\assets\icon-light.ico" LogicalName="VibranceGoggles.Icons.Light.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.9457" />
  </ItemGroup>

</Project>
