<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user installer: no admin rights, installs to %LOCALAPPDATA%\Programs\Vibrance Goggles,
  adds a Start menu shortcut, upgrades older versions in place and opens the app when done.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Vibrance Goggles"
           Manufacturer="Joel Arbaiza"
           Version="$(ProductVersion)"
           UpgradeCode="95A03C4F-7300-4C53-9C47-48CB6C5E588B"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Vibrance Goggles is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(AssetsDir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/joelarbaiza/vibrance-goggles" />
    <Property Id="ARPHELPLINK" Value="https://github.com/joelarbaiza/vibrance-goggles/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Vibrance Goggles" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Files in the user profile need a registry key path (ICE38). -->
    <Component Id="AppFiles" Directory="INSTALLFOLDER" Guid="69F6683A-1D31-45CB-9080-B4C96383825F">
      <File Id="AppExe" Source="$(AppDir)\VibranceGoggles.exe" />
      <File Id="AppConfig" Source="$(AppDir)\VibranceGoggles.exe.config" />
      <RegistryValue Root="HKCU" Key="Software\VibranceGoggles" Name="InstallDir"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <!-- Only removed if empty (it is shared with other per-user apps). -->
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="AppShortcut" Name="Vibrance Goggles" Description="Digital vibrance for Intel and AMD graphics"
                Target="[INSTALLFOLDER]VibranceGoggles.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\VibranceGoggles" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main">
      <ComponentRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Open the app after an interactive install (not for silent /qn installs). -->
    <CustomAction Id="LaunchApp" FileRef="AppExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE AND UILevel &gt;= 3" />
    </InstallExecuteSequence>
  </Package>
</Wix>
